# Copy this file to ".env" and fill in your own key.
# Create / revoke keys in the Clocked dashboard: https://clocked.rezolve.ai/account
CLOCKED_API_KEY=clk_live_replace_with_your_own_key

# Optional: override the API base URL (defaults to https://clocked.rezolve.ai/clocked)
# CLOCKED_BASE_URL=https://clocked.rezolve.ai/clocked
